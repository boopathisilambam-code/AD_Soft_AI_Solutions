# AD Soft Technologies - pretty URLs
# Works at domain root (Hostinger) AND in a subfolder (XAMPP: localhost/ad_soft_tech/)
# /about  ->  serves about.html   |   /about.html  ->  301 to /about

DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# -1. Invitation share links -> invitation.php (server-rendered title / WhatsApp preview + instant data)
#     MUST stay above the pretty-URL rules, otherwise /invitation.html is 301'd to the static page.
#     Works for:  /invitation?id=abc   /invitation.html?id=abc   /invitation-viewer.html?id=abc
RewriteRule ^invitation(?:\.html)?/?$ invitation.php [L,QSA]
RewriteRule ^invitation-viewer(?:\.html)?/?$ invitation.php [L,QSA]

# 0. Old misspelled page URLs -> corrected ones (301 keeps Google rankings and old shared links working)
RewriteCond %{REQUEST_URI} ^(.*/)ai-agent-developemnt(?:\.html)?/?$ [NC]
RewriteRule ^ %1ai-agent-development [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)ai-chatbot-developemt(?:\.html)?/?$ [NC]
RewriteRule ^ %1ai-chatbot-development [R=301,L]

# 1. /index.html -> folder root  (e.g. /ad_soft_tech/index.html -> /ad_soft_tech/)
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L,QSA]

# 2. /page.html -> /page  (only when the browser asked for .html directly, so no loop)
#    (!\.php$ : after /invitation.html is internally rewritten to invitation.php, THE_REQUEST still says .html – don't redirect it)
RewriteCond %{REQUEST_URI} !\.php$
RewriteCond %{THE_REQUEST} \s(/[^\s?]+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L,QSA]

# 3. /page/ -> /page  (a trailing slash breaks relative css/js/image paths)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L,QSA]

# 4. /page -> serve page.html silently (checks the real file next to .htaccess)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- Performance: compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript text/javascript application/json image/svg+xml application/xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json image/svg+xml application/xml font/ttf font/otf
</IfModule>

# ---------- Performance: browser caching ----------
# File names are not versioned, so CSS/JS stay short enough for updates to show within a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/ttf "access plus 30 days"
  ExpiresByType application/font-woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>